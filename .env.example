# =====================================================================
# WangStore — Environment Variables
# Salin file ini menjadi .env.local untuk pengembangan lokal:
#   cp .env.example .env.local
# JANGAN pernah meng-commit .env / .env.local / secret.
# =====================================================================

# ------------------------- APP -------------------------
NEXT_PUBLIC_SITE_NAME=WangStore
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------- DATABASE / SUPABASE -------------------------
# Jika Supabase tidak dikonfigurasi, aplikasi memakai JSON datastore lokal
# (hanya untuk pengembangan lokal). Isi ketiga variabel berikut untuk
# memakai Supabase (PostgreSQL) pada production/preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY hanya untuk server — JANGAN pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------- AUTH -------------------------
# Gunakan secret acak yang panjang (>= 32 karakter).
JWT_SECRET=

# ------------------------- CLOUDFLARE (opsional) -------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------- WHATSAPP -------------------------
# Nomor WhatsApp tujuan (format internasional tanpa '+'), contoh: 6281234567890
WHATSAPP_NUMBER=

# ------------------------- DISCORD -------------------------
DISCORD_URL=
DISCORD_WEBHOOK_URL=

# ------------------------- EMAIL -------------------------
# Layanan email hanya terpakai bila provider dikonfigurasi.
EMAIL_PROVIDER=
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# ------------------------- SECURITY -------------------------
# Kunci ini hanya untuk seeding akun owner pada JSON datastore lokal.
WANGSTORE_ADMIN_EMAIL=
WANGSTORE_ADMIN_PASSWORD=

# ------------------------- LOCAL DEV -------------------------
# Direktori data JSON lokal (default: ./data). Di-ignore dari git.
WANGSTORE_DATA_DIR=./data
