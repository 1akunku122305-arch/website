# =====================================================================
# WangStore — Environment Variables
# Salin file ini menjadi .env.local untuk pengembangan lokal:
#   cp .env.example .env.local
# JANGAN pernah meng-commit .env / .env.local / secret.
# =====================================================================

# ------------------------- APP -------------------------
NEXT_PUBLIC_SITE_NAME=WangStore
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------- DATABASE / SUPABASE -------------------------
# Jika Supabase tidak dikonfigurasi, aplikasi memakai JSON datastore lokal
# (hanya untuk pengembangan lokal). Isi ketiga variabel berikut untuk
# memakai Supabase (PostgreSQL) pada production/preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY hanya untuk server — JANGAN pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------- AUTH -------------------------
# Gunakan secret acak yang panjang (>= 32 karakter).
JWT_SECRET=

# ------------------------- CLOUDFLARE (opsional) -------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------- WHATSAPP -------------------------
# Nomor WhatsApp tujuan (format internasional tanpa '+'), contoh: 6281234567890
WHATSAPP_NUMBER=

# ------------------------- DISCORD -------------------------
DISCORD_URL=
DISCORD_WEBHOOK_URL=

# ------------------------- EMAIL -------------------------
# Layanan email hanya terpakai bila provider dikonfigurasi.
# Provider: 'resend' (REST API) atau 'smtp' (nodemailer).
# Biarkan kosong untuk development (tautan verifikasi lokal ditampilkan).
# Semua kredensial WAJIB berada di environment, JANGAN pernah ke browser.
EMAIL_PROVIDER=
# Pengirim email. Bisa berisi nama: "WangStore <no-reply@example.com>"
EMAIL_FROM=
EMAIL_FROM_NAME=WangStore

# Provider Resend (https://resend.com) — serverless-friendly
RESEND_API_KEY=
# EMAIL_API_KEY dipertahankan sebagai alias lama untuk Resend.

# Provider SMTP (mis. Brevo, Mailgun, Zoho, Gmail app password, dll)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Masa berlaku token (menit). Default 60, rentang aman 5–1440.
EMAIL_VERIFY_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=60

# ------------------------- SECURITY -------------------------
# Kunci ini hanya untuk seeding akun owner pada JSON datastore lokal.
WANGSTORE_ADMIN_EMAIL=
WANGSTORE_ADMIN_PASSWORD=

# ------------------------- LOCAL DEV -------------------------
# Direktori data JSON lokal (default: ./data). Di-ignore dari git.
WANGSTORE_DATA_DIR=./data
