# ---------------------------------------------------------------------------
# WangStore — environment configuration
# Copy to .env and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://wangstore.id

# Session signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48

# Location of the JSON datastore (defaults to ./data)
WANGSTORE_DATA_DIR=./data

# Initial owner account created by scripts/install.sh
WANGSTORE_OWNER_EMAIL=owner@wangstore.id
WANGSTORE_OWNER_PASSWORD=change-this-immediately

# PostgreSQL — used by the containerised stack (docker/docker-compose.yml)
POSTGRES_USER=wangstore
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wangstore
DATABASE_URL=postgresql://wangstore:change-me-strong-password@postgres:5432/wangstore?schema=public

# Redis — rate limiting and session cache in clustered deployments
REDIS_URL=redis://redis:6379

# Runtime
NODE_ENV=production
PORT=3000
